{
  "description": "Ask the person before a confirmed medium/high-risk desktop_sequence batch runs.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_desk-pilot_desktop__desktop_sequence",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/risk-gate.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
